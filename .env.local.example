# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key         # server only

# ── Resend ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Lemon Squeezy ─────────────────────────────────────
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# Checkout URLs for each pricing card (Store → Products → copy checkout URL)
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_SOLO=https://yourstore.lemonsqueezy.com/checkout/buy/xxxx
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_PRO=https://yourstore.lemonsqueezy.com/checkout/buy/xxxx
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_AGENCY=https://yourstore.lemonsqueezy.com/checkout/buy/xxxx

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000       # Vercel URL in production

# ── PDF generation (local dev only) ────────────────────
# Point at a local Chrome/Chromium binary. Not needed in production —
# Vercel uses @sparticuz/chromium automatically.
PUPPETEER_EXECUTABLE_PATH=/path/to/chrome
