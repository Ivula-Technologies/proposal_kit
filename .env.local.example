# Copy to .env.local for local dev. On cPanel, add each of these under
# Setup Node.js App > Environment variables (see DEPLOY.md).

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000       # https://proposalkit.ivulatechnologies.com in production

# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key         # server only

# ── Resend (signed-copy emails) ───────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=ProposalKit <proposals@yourdomain.com>   # must be on a verified Resend domain

# ── Stripe ────────────────────────────────────────────
# One Stripe account runs both the ProposalKit subscription and Connect
# (freelancer payouts). scripts/stripe-setup.mjs prints all of these.
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx            # platform webhook -> /api/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxx    # Connect webhook  -> /api/webhooks/stripe
STRIPE_PRICE_SOLO=price_xxxx                # $29/mo
STRIPE_PRICE_PRO=price_xxxx                 # $59/mo
# Optional cut of each client deposit, in basis points (100 = 1%). Default 0.
PLATFORM_FEE_BPS=0

# ── Cron + support ─────────────────────────────────────
CRON_SECRET=any_long_random_string          # protects /api/cron/* (daily trial reminders)
SUPPORT_EMAIL=support@yourdomain.com        # optional reply-to on trial reminder emails

# ── PDF generation ────────────────────────────────────
# Optional. Point at a Chrome/Chromium binary. Leave unset on Linux servers
# to use the bundled @sparticuz/chromium; needed on macOS/Windows dev boxes.
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome
